// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowStatus {
  PUBLISHED
  QUARANTINED
  REJECTED
}

model User {
  id               String     @id @default(uuid())
  githubId         String     @unique
  username         String     @unique
  avatarUrl        String?
  workflows        Workflow[] @relation("AuthoredWorkflows")
  starredWorkflows Star[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Workflow {
  id           String  @id @default(uuid())
  name         String
  description  String?
  owner        String
  repo         String
  path         String? @default("archon.yaml")
  version      String? @default("1.0.0")
  author       User    @relation("AuthoredWorkflows", fields: [authorId], references: [id])
  authorId     String
  stars        Star[]
  installCount Int     @default(0)

  // Security Fields
  securityScore  Int            @default(100)
  status         WorkflowStatus @default(QUARANTINED)
  securityReport Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([owner, repo, path])
}

model Star {
  userId     String
  workflowId String
  user       User     @relation(fields: [userId], references: [id])
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  createdAt  DateTime @default(now())

  @@id([userId, workflowId])
}
